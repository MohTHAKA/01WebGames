{
    "name": "01webgames",
    "version": "0.0.0",
    "private": true,
    "description": "ZERO1 Learn & Play — Blockly + PlayCanvas robot missions for 01skills.com",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:unity": "vite build --mode unity --outDir ../webgameIF/Assets/StreamingAssets/Web --emptyOutDir",
        "dev": "vite --open",
        "export:missions": "node scripts/export-missions.mjs",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "vite preview --open",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "blockly": "^13.5.0",
        "playcanvas": "^2.24.1"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0",
        "@playcanvas/inspector": "^0.5.0",
        "eslint": "^9.39.5",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
